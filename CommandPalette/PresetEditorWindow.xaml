<Window x:Class="CommandPalette.PresetEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CommandPalette"

        Title="Presets"

        Width="900"
        Height="560"

        WindowStartupLocation="CenterScreen"

        Background="#171717"
        Foreground="Gray">

    <Grid Margin="18">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================================================== -->
        <!-- PRESET LIST -->
        <!-- ================================================== -->

        <Grid Grid.Column="0">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock
                Text="Presets"
                FontSize="20"
                FontWeight="SemiBold"
                Margin="4,0,0,12"/>

            <ListBox
                x:Name="PresetList"

                Grid.Row="1"

                Background="#202020"
                Foreground="White"

                BorderBrush="#353535"

                DisplayMemberPath="Name"

                SelectionChanged="PresetList_SelectionChanged"/>

            <Grid
                Grid.Row="2"
                Margin="0,12,0,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button
                    Grid.Column="0"

                    Height="34"

                    Content="+ New"

                    Click="NewPreset_Click"/>

                <Button
                    Grid.Column="2"

                    Height="34"

                    Content="Delete"

                    Click="DeletePreset_Click"/>

            </Grid>

        </Grid>

        <!-- ================================================== -->
        <!-- EDITOR -->
        <!-- ================================================== -->

        <Grid
            x:Name="EditorPanel"
            Grid.Column="2">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ID -->

            <Grid Grid.Row="0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock
                    VerticalAlignment="Center"
                    Text="Id"/>

                <TextBox
                    x:Name="IdBox"

                    Grid.Column="1"

                    Height="32"

                    Padding="8,0"

                    VerticalContentAlignment="Center"/>

            </Grid>

            <!-- NAME -->

            <Grid
                Grid.Row="1"
                Margin="0,10,0,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock
                    VerticalAlignment="Center"
                    Text="Name"/>

                <TextBox
                    x:Name="NameBox"

                    Grid.Column="1"

                    Height="32"

                    Padding="8,0"

                    VerticalContentAlignment="Center"/>

            </Grid>

            <!-- DESCRIPTION -->

            <Grid
                Grid.Row="2"
                Margin="0,10,0,16">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock
                    VerticalAlignment="Center"
                    Text="Description"/>

                <TextBox
                    x:Name="DescriptionBox"

                    Grid.Column="1"

                    Height="32"

                    Padding="8,0"

                    VerticalContentAlignment="Center"/>

            </Grid>

            <!-- ACTIONS -->

            <Grid Grid.Row="3">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock
                    Text="Actions"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Margin="0,0,0,8"/>

                <DataGrid
                    x:Name="ActionsGrid"

                    Grid.Row="1"

                    AutoGenerateColumns="False"

                    CanUserAddRows="False"

                    Background="#202020"
                    Foreground="Black"

                    BorderBrush="#353535"

                    HeadersVisibility="Column">

                    <DataGrid.Columns>

                        <DataGridComboBoxColumn
                            Header="Type"
                            Width="170"

                            ItemsSource="{x:Static local:PresetEditorWindow.ActionTypes}"

                            SelectedItemBinding="{Binding Type,
                                Mode=TwoWay,
                                UpdateSourceTrigger=PropertyChanged}"/>

                        <DataGridTextColumn
                            Header="Target"
                            Width="*"

                            Binding="{Binding Target,
                                Mode=TwoWay,
                                UpdateSourceTrigger=PropertyChanged}"/>

                    </DataGrid.Columns>

                </DataGrid>

            </Grid>

            <!-- ACTION BUTTONS -->

            <StackPanel
                Grid.Row="4"

                Margin="0,10,0,0"

                Orientation="Horizontal">

                <Button
                    Width="110"
                    Height="32"

                    Content="+ Action"

                    Click="AddAction_Click"/>

                <Button
                    Width="120"
                    Height="32"

                    Margin="8,0,0,0"

                    Content="Delete Action"

                    Click="DeleteAction_Click"/>

            </StackPanel>

            <!-- SAVE -->

            <Grid
                Grid.Row="5"
                Margin="0,18,0,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock
                    x:Name="StatusText"

                    VerticalAlignment="Center"

                    Foreground="#909090"/>

                <Button
                    Grid.Column="1"

                    Width="100"
                    Height="36"

                    Content="Save"

                    Click="Save_Click"/>

                <Button
                    Grid.Column="3"

                    Width="100"
                    Height="36"

                    Content="Close"

                    Click="Close_Click"/>

            </Grid>

        </Grid>

    </Grid>

</Window>